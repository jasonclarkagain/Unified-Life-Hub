modules = ["nodejs-24", "rust-stable"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["google-mail:1.0.0", "github:1.0.0", "outlook:1.0.0", "google-drive:1.0.0", "onedrive:1.0.0", "hubspot:1.0.0", "spotify:1.0.0", "gitlab:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 26025
externalPort = 3000

[nix]
channel = "stable-25_05"
